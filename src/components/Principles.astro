---
// Блок «Принципы BitEon»: заголовок и вступление слева, четыре пункта с пиксельными иконками справа.
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale).principles;
---

<section class="section" id="principles" aria-labelledby="principles-title">
  <div class="container principles">
    <div class="principles-head">
      <h2 id="principles-title">{t.title}</h2>
      <p class="muted">{t.lead}</p>
    </div>
    <ul class="principles-list" role="list">
      {
        t.points.map((p) => (
          <li>
            <span class="principles-pixel" aria-hidden="true" />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-7);
  }

  .principles-head {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .principles-head h2 {
    font-size: var(--fs-h2);
  }

  .principles-head p {
    font-size: var(--fs-lead);
  }

  .principles-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .principles-list li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  /* Маленький «пиксель» — отсылка к фирменному мотиву. */
  .principles-pixel {
    width: 10px;
    height: 10px;
    background: var(--accent);
    box-shadow:
      14px 0 0 -2px rgb(189 218 38 / 0.5),
      24px -6px 0 -3px rgb(189 218 38 / 0.3);
    margin-block-end: var(--space-3);
  }

  .principles-list h3 {
    font-size: var(--fs-h3);
  }

  .principles-list p {
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .principles {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .principles-list {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
