---
// Ненавязчивая подсказка: «Эта страница есть на вашем языке». Никаких автоматических
// переходов — человек сам решает. Закрыл один раз — больше не показываем (localStorage).
// Без JavaScript подсказки просто нет.
import { locales, getLocaleInfo, localizePath, useTranslations, fill } from '../i18n';

const current = getLocaleInfo(Astro.currentLocale).code;
const hints = Object.fromEntries(
  locales.map((l) => {
    const t = useTranslations(l.code).language;
    // Название языка на нём самом, в форме для текста: «English», «Deutsch», «русский», «ไทย».
    const language = new Intl.DisplayNames([l.code], { type: 'language' }).of(l.code) ?? l.name;
    return [
      l.code,
      {
        text: fill(t.hint, { language }),
        action: t.hintAction,
        close: t.hintClose,
        dir: l.dir,
        href: localizePath(Astro.url.pathname, l.code),
      },
    ];
  }),
);
---

<aside class="lang-hint" data-lang-hint data-current={current} data-hints={JSON.stringify(hints)} hidden>
  <p data-hint-text></p>
  <a class="btn btn-primary btn-sm" href={Astro.url.pathname} data-hint-link data-lang-link></a>
  <button type="button" class="lang-hint-close" data-hint-close>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>
</aside>

<script>
  const KEY = 'biteon-lang-hint';
  const box = document.querySelector<HTMLElement>('[data-lang-hint]');
  const storage = {
    get: () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return 'off';
      }
    },
    off: () => {
      try {
        localStorage.setItem(KEY, 'off');
      } catch {}
    },
  };

  if (box && storage.get() !== 'off') {
    type Hint = { text: string; action: string; close: string; dir: string; href: string };
    const hints: Record<string, Hint> = JSON.parse(box.dataset.hints ?? '{}');
    const current = box.dataset.current;
    // Первый язык браузера, на котором есть сайт.
    const wanted = (navigator.languages ?? [navigator.language])
      .map((l) => l.toLowerCase().split('-')[0])
      .find((code) => code in hints);

    if (wanted && wanted !== current) {
      const h = hints[wanted];
      box.lang = wanted;
      box.dir = h.dir;
      box.querySelector('[data-hint-text]')!.textContent = h.text;
      const link = box.querySelector<HTMLAnchorElement>('[data-hint-link]')!;
      link.href = h.href;
      link.hreflang = wanted;
      link.textContent = h.action;
      const close = box.querySelector<HTMLButtonElement>('[data-hint-close]')!;
      close.setAttribute('aria-label', h.close);
      close.title = h.close;
      link.addEventListener('click', storage.off);
      close.addEventListener('click', () => {
        storage.off();
        box.hidden = true;
      });
      box.hidden = false;
    }
  }
</script>

<style>
  .lang-hint {
    position: fixed;
    z-index: 40;
    inset-block-end: var(--space-4);
    inset-inline-end: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    max-width: min(25rem, 100vw - 2 * var(--gutter));
    padding: var(--space-4) var(--space-5);
    padding-inline-end: var(--space-7);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.5);
    font-size: var(--fs-small);
  }

  .lang-hint[hidden] {
    display: none;
  }

  .lang-hint p {
    flex: 1 1 12rem;
  }

  .lang-hint-close {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-end: var(--space-2);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .lang-hint-close:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-hint {
      animation: hint-in 400ms var(--ease-out) both;
    }
    @keyframes hint-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>
