---
import { Font, fontData } from 'astro:assets';
import { site } from '../data/site';
import { locales, defaultLocale, getLocaleInfo, localizePath } from '../i18n';
import { montserratSubsets } from '../i18n/fonts.mjs';

export interface SeoProps {
  /** До ~60 символов */
  title: string;
  /** До ~155 символов */
  description: string;
  /** Картинка 1200×630 для соцсетей (путь от корня сайта или полный URL) */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image = site.defaultOgImage, imageAlt = site.name, type = 'website', noindex = false } =
  Astro.props as SeoProps;

const locale = getLocaleInfo(Astro.currentLocale);
// canonical — на свою языковую версию страницы.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// hreflang: эта же страница на всех языках + x-default на английскую.
const alternates = locales.map((l) => ({
  hreflang: l.code,
  href: new URL(localizePath(Astro.url.pathname, l.code), Astro.site).href,
}));
const xDefault = new URL(localizePath(Astro.url.pathname, defaultLocale), Astro.site).href;

// Заранее грузим только нужные части Montserrat (латиница + кириллица/вьетнамский/latin-ext для своих языков).
const preloadSubsets = locale.montserrat ?? ['latin'];
const brandPreloads = (fontData['--font-brand'] ?? [])
  .filter((_, i) => preloadSubsets.includes(montserratSubsets[i]))
  .map((f) => f.src[0]?.url)
  .filter(Boolean);
// Шрифт письменности (арабский, тайский, хинди) — один небольшой файл: грузим заранее,
// чтобы текст не «прыгал» при подмене шрифта (CLS).
const scriptData = locale.script ? (fontData[`--font-${locale.script}` as '--font-brand'] ?? []) : [];
const scriptPreloads = scriptData.length === 1 ? [scriptData[0].src[0]?.url].filter(Boolean) : [];

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[seo] title длиннее 60 символов: "${title}"`);
  if (description.length > 155) console.warn(`[seo] description длиннее 155 символов на ${Astro.url.pathname}`);
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
{
  !noindex &&
    alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta name="theme-color" content="#000000" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

{[...brandPreloads, ...scriptPreloads].map((url) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
<Font cssVariable="--font-brand" />
{/* Шрифт письменности (японский, корейский, тайский, хинди, арабский) — только на страницах своего языка. */}
{locale.script === 'ja' && <Font cssVariable="--font-ja" />}
{locale.script === 'ko' && <Font cssVariable="--font-ko" />}
{locale.script === 'th' && <Font cssVariable="--font-th" />}
{locale.script === 'hi' && <Font cssVariable="--font-hi" />}
{locale.script === 'ar' && <Font cssVariable="--font-ar" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={locale.og} />
{locales.filter((l) => l.code !== locale.code).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
