---
import { Font } from 'astro:assets';
import { site } from '../data/site';

export interface SeoProps {
  /** До ~60 символов */
  title: string;
  /** До ~155 символов */
  description: string;
  /** Картинка 1200×630 для соцсетей (путь от корня сайта или полный URL) */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image = site.defaultOgImage, imageAlt = 'BitEon Studio', type = 'website', noindex = false } =
  Astro.props as SeoProps;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[seo] title длиннее 60 символов: "${title}"`);
  if (description.length > 155) console.warn(`[seo] description длиннее 155 символов на ${Astro.url.pathname}`);
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#000000" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<Font cssVariable="--font-brand" preload />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
