---
// Логотип BitEon Studio: лаймовый значок с буквой «B» — это первая буква названия,
// сразу за ним белым «itEon Studio». Вместе читается как «BitEon Studio».
// Одинаковый на всех языках и не зеркалится в арабской версии.
import { badgeSvg } from '../lib/logo.mjs';

interface Props {
  class?: string;
  /** Сторона значка в px */
  size?: number;
  /** Показывать «itEon Studio» рядом со значком */
  wordmark?: boolean;
}

const { class: className, size = 32, wordmark = false } = Astro.props;
// У каждого логотипа на странице свой id сетки, иначе браузер их путает.
const id = `bl-${Math.random().toString(36).slice(2, 8)}`;
const svg = badgeSvg({ size, id, title: wordmark ? undefined : 'BitEon Studio' });
---

<span class:list={['logo', className]} dir="ltr" style={`--logo-size:${size}px`}>
  <Fragment set:html={svg} />
  {wordmark && <span class="logo-name" aria-hidden="true">itEon Studio</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.12);
    /* Логотип всегда слева направо, даже на арабских страницах. */
    direction: ltr;
    unicode-bidi: isolate;
    user-select: none;
    -webkit-user-select: none;
  }
  .logo :global(svg) {
    flex: none;
    display: block;
  }
  .logo-name {
    font-family: var(--font-brand);
    color: var(--text);
    font-weight: 700;
    font-size: calc(var(--logo-size) * 0.66);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
