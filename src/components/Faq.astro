---
// Блок вопросов и ответов + разметка FAQPage для поисковиков.
// Работает без JavaScript (элемент <details>).
import JsonLd from './JsonLd.astro';

interface Props {
  id?: string;
  title: string;
  intro?: string;
  items: { q: string; a: string }[];
}
const { id = 'faq', title, intro, items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq">
    <div class="section-head">
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq-list">
      {
        items.map((item) => (
          <details>
            <summary>
              <h3>{item.q}</h3>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <JsonLd data={schema} />
</section>

<style>
  .faq {
    max-width: 52rem;
  }

  .faq-list {
    border-block-start: 1px solid var(--line);
  }

  details {
    border-block-end: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  summary:hover h3 {
    color: var(--accent);
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-block-start: -1px;
    background: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  details p {
    color: var(--text-muted);
    padding-block-end: var(--space-5);
    max-width: 44rem;
  }
</style>
