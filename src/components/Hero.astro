---
import { Picture } from 'astro:assets';
import PixelScatter from './PixelScatter.astro';
import mascot from '../assets/mascot/mascot-2d.png';
import { localizePath, useTranslations } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">{t.title}</h1>
      <p class="hero-lead">{t.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={localizePath('/#apps', locale)}>
          {t.primary}
          <svg class="icon-dir" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M7 6h7v7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a class="btn btn-outline" href={localizePath('/#faq', locale)}>{t.secondary}</a>
      </div>
    </div>

    <div class="hero-visual" data-parallax>
      <div class="hero-glow" aria-hidden="true"></div>
      <PixelScatter class="hero-pixels" />
      <!-- Место под маскота зарезервировано размерами: при загрузке ничего не сдвигается.
           Картинка вырезана из фона (прозрачный PNG → AVIF/WebP), поэтому края фона не видно.
           На этапе 2 здесь поверх появится 3D-модель, а картинка останется заглушкой. -->
      <div class="mascot" id="mascot">
        <Picture
          src={mascot}
          formats={['avif', 'webp']}
          widths={[240, 360, 522]}
          sizes="(min-width: 900px) 330px, 230px"
          alt={t.mascotAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Лёгкий параллакс маскота за курсором. Не включается на сенсорных экранах
  // и при «уменьшить движение».
  const visual = document.querySelector<HTMLElement>('[data-parallax]');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (visual && canHover && !reduce) {
    const hero = visual.closest('.hero') as HTMLElement;
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        visual.style.setProperty('--px', x.toFixed(3));
        visual.style.setProperty('--py', y.toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      visual.style.setProperty('--px', '0');
      visual.style.setProperty('--py', '0');
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-2) 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }

  .hero-copy {
    display: grid;
    gap: var(--space-5);
    max-width: 36rem;
    position: relative;
    z-index: 1;
    /* Текст чуть выше оптического центра маскота — первый экран плотнее. */
    padding-block-end: var(--space-8);
  }

  .hero h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
  }

  .hero-lead {
    font-size: var(--fs-lead);
    color: var(--text-muted);
    max-width: 30rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  /* Визуальная часть: свечение, пиксели, маскот. Всё внутри своего блока — ничего не наезжает
     на следующие секции. Высота подобрана так, чтобы маскот целиком помещался в первый экран. */
  .hero-visual {
    --px: 0;
    --py: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    height: clamp(420px, calc(100svh - var(--header-h) - var(--space-5)), 720px);
    padding-block: var(--space-4) var(--space-3);
    contain: layout paint;
  }

  /* Свечение: мягкий радиальный градиент без рамок — растворяется в чёрном со всех сторон. */
  .hero-glow {
    position: absolute;
    /* Отступ снизу больше радиуса размытия: свечение гаснет раньше края блока, без «среза». */
    inset: 6% 2% 11%;
    z-index: -2;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, rgb(189 218 38 / 0.34), rgb(189 218 38 / 0.1) 55%, transparent 100%),
      radial-gradient(40% 10% at 50% 92%, rgb(189 218 38 / 0.2), transparent 100%);
    filter: blur(28px);
  }

  .hero-visual :global(.hero-pixels) {
    position: absolute;
    z-index: -1;
    width: min(118%, 640px);
    height: auto;
    aspect-ratio: 1;
    transform: translate(calc(var(--px) * -18px), calc(var(--py) * -14px));
    transition: transform 600ms var(--ease-out);
  }

  .mascot {
    flex: none;
    height: 100%;
    aspect-ratio: 522 / 1186;
    transform: translate(calc(var(--px) * 12px), calc(var(--py) * 8px));
    transition: transform 600ms var(--ease-out);
  }

  .mascot :global(picture) {
    display: block;
    height: 100%;
  }

  .mascot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Лёгкая тень и лаймовый контровой свет вокруг фигуры. */
    filter: drop-shadow(0 0 22px rgb(189 218 38 / 0.18)) drop-shadow(0 18px 24px rgb(0 0 0 / 0.5));
  }

  /* Один момент при загрузке: свечение разгорается, маскот плавно поднимается. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: glow-in 1400ms var(--ease-out) both;
    }
    .mascot :global(picture) {
      animation: mascot-in 1100ms var(--ease-out) both;
    }
    @keyframes glow-in {
      from {
        opacity: 0;
        transform: scale(0.7);
      }
    }
    @keyframes mascot-in {
      from {
        transform: translateY(28px) scale(0.97);
      }
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block-start: var(--space-6);
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero-copy {
      padding-block-end: 0;
    }
    .hero-visual {
      height: clamp(400px, 115vw, 540px);
    }
  }
</style>
