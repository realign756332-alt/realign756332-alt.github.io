---
// Блок «New releases» на главной. Показывается только при наличии хотя бы одного
// реального (не примерного) приложения — вместе с ним появляются пункт меню «New» и кнопка «What's new».
import { Image } from 'astro:assets';
import { getPublicApps, priceLabel, platformName, appHref, appText } from '../lib/apps';
import { sections } from '../data/site';
import { useTranslations, languageList } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const dict = useTranslations(locale);
const t = dict.apps;
const r = dict.releases;

const apps = (await getPublicApps()).slice(0, 8);
---

{
  apps.length > 0 && (
    <section class="section" id="new" aria-labelledby="new-title">
      <div class="container">
        <div class="section-head">
          <h2 id="new-title">{r.title}</h2>
          <p>{r.lead}</p>
        </div>

        <ul class="app-list" role="list">
          {apps.map((app) => {
            const d = app.data;
            const text = appText(app, locale);
            const live = d.status === 'live';
            return (
              <li class="app" id={`app-${d.slug}`}>
                <Image src={d.icon} alt="" width={64} height={64} class="app-icon" loading="lazy" draggable="false" />
                <div class="app-main">
                  <h3>
                    {sections.apps ? <a href={appHref(app, locale)}>{d.name}</a> : d.name}
                    <span class:list={['tag', live ? 'tag-live' : 'tag-soon']}>{live ? r.available : r.comingSoon}</span>
                  </h3>
                  <p class="app-tagline">{text.tagline}</p>
                  <p class="app-meta">
                    <span>{d.type === 'mobile' ? t.typeMobile : t.typeWeb}</span>
                    <span>{d.platforms.map((p) => platformName(p, locale)).join(', ')}</span>
                    <span>{priceLabel(app, locale)}</span>
                  </p>
                  {d.appLanguages.length > 0 && (
                    <p class="app-langs">
                      {t.appLanguages} <span>{languageList(d.appLanguages, locale)}</span>
                    </p>
                  )}
                </div>
                {live && (
                  <div class="app-action">
                    {d.type === 'mobile' && d.appStoreUrl && (
                      <a class="btn btn-primary btn-sm" href={d.appStoreUrl}>{t.appStore}</a>
                    )}
                    {d.type === 'mobile' && d.googlePlayUrl && (
                      <a class="btn btn-outline btn-sm" href={d.googlePlayUrl}>{t.googlePlay}</a>
                    )}
                    {d.type === 'web' && d.webAppUrl && (
                      <a class="btn btn-primary btn-sm" href={d.webAppUrl}>{t.openApp}</a>
                    )}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .app-list {
    border-block-start: 1px solid var(--line);
  }

  .app {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--line);
  }

  .app :global(.app-icon) {
    width: 64px;
    height: 64px;
    border-radius: 16px;
  }

  .app-main {
    display: grid;
    gap: var(--space-1);
  }

  .app h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--fs-h3);
  }

  .app h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .app h3 a:hover {
    color: var(--accent);
  }

  .app-tagline {
    color: var(--text-muted);
  }

  .app-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .app-meta span + span::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-inline-end: var(--space-4);
    vertical-align: middle;
    background: var(--accent);
    opacity: 0.7;
  }

  .app-langs {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .app-langs span {
    color: var(--text);
  }

  .app-action {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
    white-space: nowrap;
  }

  .tag-live {
    color: var(--on-accent);
    background: var(--accent);
  }

  .tag-soon {
    color: var(--accent);
    background: rgb(189 218 38 / 0.1);
    border: 1px solid rgb(189 218 38 / 0.3);
  }

  @media (max-width: 640px) {
    .app {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: var(--space-4);
    }
    .app :global(.app-icon) {
      width: 52px;
      height: 52px;
      border-radius: 13px;
    }
    .app-action {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
</style>
