---
// Подвал собирается из данных: новые приложения, категории и разделы
// появляются в нём автоматически.
import Logo from './Logo.astro';
import { site, sections } from '../data/site';
import { getPublicApps, getActiveCategories, appHref, categoryHref } from '../lib/apps';

type Link = { label: string; href: string; external?: boolean };

const apps = await getPublicApps();
const activeCategories = await getActiveCategories();

const columns: { title: string; links: Link[] }[] = [
  { title: 'Apps', links: apps.map((a) => ({ label: a.data.name, href: appHref(a) })) },
  { title: 'Categories', links: activeCategories.map((c) => ({ label: c.name, href: categoryHref(c.slug) })) },
  {
    title: 'Compare',
    links: sections.compare ? [{ label: 'All comparisons', href: '/compare/' }] : [],
  },
  {
    title: 'Tools',
    links: sections.tools ? [{ label: 'All free tools', href: '/tools/' }] : [],
  },
  {
    title: 'FAQ',
    links: [{ label: 'Buying & refunds', href: sections.faq ? '/faq/' : '/#faq' }],
  },
  {
    title: 'Company',
    links: [
      ...(sections.company
        ? [
            { label: 'About', href: '/about/' },
            { label: 'Contact', href: '/contact/' },
            { label: 'Privacy', href: '/privacy/' },
            { label: 'Terms', href: '/terms/' },
            { label: 'Refund policy', href: '/refund-policy/' },
          ]
        : []),
      ...(site.youtubeUrl ? [{ label: 'YouTube', href: site.youtubeUrl, external: true }] : []),
    ],
  },
].filter((col) => col.links.length > 0);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="BitEon Studio, home" class="footer-logo">
        <Logo size={28} wordmark />
      </a>
      <p class="muted">Focused mobile and web apps, made by one small studio.</p>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="footer-col">
            <h2>{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { rel: 'me noopener', target: '_blank' } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} BitEon Studio</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--line);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--fs-small);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-7);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    max-width: 18rem;
  }

  .footer-logo {
    text-decoration: none;
    width: fit-content;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-6);
  }

  .footer-col h2 {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer-col a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
