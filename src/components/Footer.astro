---
// Подвал собирается из данных: новые приложения, категории и разделы
// появляются в нём автоматически.
import Logo from './Logo.astro';
import { site, sections } from '../data/site';
import { getPublicApps, getActiveCategories, appHref, categoryHref } from '../lib/apps';
import { localizePath, useTranslations } from '../i18n';

type Link = { label: string; href: string; external?: boolean };

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const f = t.footer;
const to = (path: string) => localizePath(path, locale);

const apps = await getPublicApps();
const activeCategories = await getActiveCategories();

const columns: { title: string; links: Link[] }[] = [
  { title: f.apps, links: apps.map((a) => ({ label: a.data.name, href: appHref(a, locale) })) },
  {
    title: f.categories,
    links: activeCategories.map((c) => ({ label: t.categories.items[c.slug].name, href: categoryHref(c.slug, locale) })),
  },
  {
    title: f.compare,
    links: sections.compare ? [{ label: f.allComparisons, href: to('/compare/') }] : [],
  },
  {
    title: f.tools,
    links: sections.tools ? [{ label: f.allTools, href: to('/tools/') }] : [],
  },
  {
    title: f.faq,
    links: [{ label: f.buyingRefunds, href: to(sections.faq ? '/faq/' : '/#faq') }],
  },
  {
    title: f.company,
    links: [
      ...(sections.company
        ? [
            { label: f.about, href: to('/about/') },
            { label: f.contact, href: to('/contact/') },
            { label: f.privacy, href: to('/privacy/') },
            { label: f.terms, href: to('/terms/') },
            { label: f.refundPolicy, href: to('/refund-policy/') },
          ]
        : []),
      ...(site.youtubeUrl ? [{ label: 'YouTube', href: site.youtubeUrl, external: true }] : []),
    ],
  },
].filter((col) => col.links.length > 0);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={to('/')} aria-label={t.a11y.homeLink} class="footer-logo">
        <Logo size={28} wordmark />
      </a>
      <p class="muted">{f.tagline}</p>
    </div>

    <nav class="footer-cols" aria-label={t.a11y.footerNav}>
      {
        columns.map((col) => (
          <div class="footer-col">
            <h2>{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { rel: 'me noopener', target: '_blank' } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} BitEon Studio</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-gap);
    border-block-start: 1px solid var(--line);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--fs-small);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-7);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    max-width: 18rem;
  }

  .footer-logo {
    text-decoration: none;
    width: fit-content;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-6);
  }

  .footer-col h2 {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0;
    margin-block-end: var(--space-3);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer-col a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--line);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
