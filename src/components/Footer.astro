---
// Подвал: колонки Apps, Support, Company, Legal (тексты — из site-copy.md).
// Показываются только ссылки на страницы и блоки, которые уже существуют:
// когда раздел готов (sections в src/data/site.ts), его ссылки появляются здесь сами.
import Logo from './Logo.astro';
import { site, sections } from '../data/site';
import { fill, localizePath, useTranslations } from '../i18n';

type Link = { label: string; href: string; external?: boolean };

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const f = t.footer;
const to = (path: string) => localizePath(path, locale);

const columns: { title: string; links: Link[] }[] = [
  {
    title: f.apps,
    links: sections.apps
      ? [
          { label: f.allApps, href: to('/apps/') },
          { label: f.mobileApps, href: to('/apps/mobile/') },
          { label: f.webApps, href: to('/apps/web/') },
        ]
      : [],
  },
  {
    title: f.support,
    links: [
      { label: f.helpFaq, href: to(sections.faq ? '/faq/' : '/#faq') },
      ...(sections.company ? [{ label: f.contact, href: to('/contact/') }] : []),
    ],
  },
  {
    title: f.company,
    links: [
      ...(sections.company ? [{ label: f.about, href: to('/about/') }] : []),
      ...(site.youtubeUrl ? [{ label: 'YouTube', href: site.youtubeUrl, external: true }] : []),
    ],
  },
  {
    title: f.legal,
    links: sections.company
      ? [
          { label: f.privacy, href: to('/privacy/') },
          { label: f.terms, href: to('/terms/') },
        ]
      : [],
  },
].filter((col) => col.links.length > 0);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={to('/')} aria-label={t.a11y.homeLink} class="footer-logo">
        <Logo size={28} wordmark />
      </a>
      <p class="muted">{f.tagline}</p>
    </div>

    <nav class="footer-cols" aria-label={t.a11y.footerNav}>
      {
        columns.map((col) => (
          <div class="footer-col">
            <h2>{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { rel: 'me noopener', target: '_blank' } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>{fill(f.rights, { year })}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-gap);
    border-block-start: 1px solid var(--line);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--fs-small);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-7);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    max-width: 18rem;
  }

  .footer-logo {
    text-decoration: none;
    width: fit-content;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-6);
  }

  .footer-col h2 {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0;
    margin-block-end: var(--space-3);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer-col a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--line);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
