---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { visibleNav, headerCta } from '../data/navigation';
import { hasPublicApps } from '../lib/apps';
import { localizePath, useTranslations } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const nav = visibleNav(await hasPublicApps()).map((item) => ({
  label: t.nav[item.key],
  href: localizePath(item.href, locale),
}));
const cta = { label: t.nav[headerCta.key], href: localizePath(headerCta.href, locale) };
const home = localizePath('/', locale);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href={home} class="brand" aria-label={t.a11y.homeLink}>
      <Logo size={32} wordmark />
    </a>

    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <LanguageSwitcher />

    <a class="btn btn-primary btn-sm header-cta" href={cta.href}>{cta.label}</a>

    <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-label={t.a11y.openMenu}>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="nav-mobile" popover aria-label={t.a11y.mainNav}>
    <div class="nav-mobile-top">
      <Logo size={32} wordmark />
      <button type="button" popovertarget="mobile-menu" popovertargetaction="hide" class="menu-toggle" aria-label={t.a11y.closeMenu}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
  </nav>
</header>

<script>
  // Закрываем мобильное меню после перехода по якорю на той же странице.
  const menu = document.getElementById('mobile-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover?.()));

  // Как только страница прокручена, шапка получает тёмный полупрозрачный фон с размытием,
  // чтобы контент не просвечивал под логотипом и меню. Без JavaScript фон есть всегда.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    header.dataset.js = '';
    let ticking = false;
    const update = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    height: var(--header-h);
    border-block-end: 1px solid var(--line);
    /* Тёмный полупрозрачный фон (фирменный тёмно-синий, почти чёрный) + размытие того, что под ним. */
    --header-blur: blur(20px) saturate(140%);
    background: rgb(4 12 19 / 0.86);
    backdrop-filter: var(--header-blur);
    transition:
      background-color var(--dur) ease,
      border-color var(--dur) ease;
  }

  /* Для Safari до 18 — версия с префиксом. Отдельным правилом: если написать оба свойства рядом,
     сборщик CSS оставляет только одно из них (раньше из-за этого в Chrome размытия не было вовсе). */
  header.site-header {
    -webkit-backdrop-filter: var(--header-blur);
  }

  /* На самом верху страницы (скрипт это отмечает) шапка прозрачная — первый экран «дышит». */
  .site-header[data-js]:not([data-scrolled]) {
    --header-blur: none;
    background: rgb(0 0 0 / 0);
    border-block-end-color: transparent;
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand {
    text-decoration: none;
    margin-inline-end: auto;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-2);
  }

  .nav-desktop a,
  .nav-mobile ul a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast), background-color var(--dur-fast);
  }

  .nav-desktop a:hover {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .nav-mobile {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) var(--space-6);
    border: 0;
    background: var(--bg);
    color: var(--text);
    flex-direction: column;
    gap: var(--space-6);
  }

  .nav-mobile:popover-open {
    display: flex;
  }

  .nav-mobile-top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-mobile-top .menu-toggle {
    display: grid;
  }

  .nav-mobile ul {
    display: grid;
    gap: var(--space-1);
  }

  .nav-mobile ul a {
    display: block;
    font-size: 1.5rem;
    font-weight: 650;
    padding: var(--space-3) 0;
  }

  @media (max-width: 960px) {
    .header-inner {
      gap: var(--space-3);
    }
    .nav-desktop,
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
</style>
