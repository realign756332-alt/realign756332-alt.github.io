---
import Logo from './Logo.astro';
import { mainNav, headerCta } from '../data/navigation';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="BitEon Studio, home">
      <Logo size={30} wordmark />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul role="list">
        {mainNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-primary btn-sm header-cta" href={headerCta.href}>{headerCta.label}</a>

    <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="nav-mobile" popover aria-label="Main">
    <div class="nav-mobile-top">
      <Logo size={30} wordmark />
      <button type="button" popovertarget="mobile-menu" popovertargetaction="hide" class="menu-toggle" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul role="list">
      {mainNav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    <a class="btn btn-primary" href={headerCta.href}>{headerCta.label}</a>
  </nav>
</header>

<script>
  // Закрываем мобильное меню после перехода по якорю на той же странице.
  const menu = document.getElementById('mobile-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover?.()));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
  }

  /* При прокрутке шапка становится фирменной тёмно-синей — без JavaScript. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      background: rgb(0 0 0 / 0);
      animation: header-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 120px;
    }
    @keyframes header-solid {
      to {
        background: rgb(10 25 38 / 0.9);
        border-bottom-color: var(--line);
      }
    }
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand {
    text-decoration: none;
    margin-right: auto;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-2);
  }

  .nav-desktop a,
  .nav-mobile ul a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast), background-color var(--dur-fast);
  }

  .nav-desktop a:hover {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .nav-mobile {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) var(--space-6);
    border: 0;
    background: var(--bg);
    color: var(--text);
    flex-direction: column;
    gap: var(--space-6);
  }

  .nav-mobile:popover-open {
    display: flex;
  }

  .nav-mobile-top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-mobile-top .menu-toggle {
    display: grid;
  }

  .nav-mobile ul {
    display: grid;
    gap: var(--space-1);
  }

  .nav-mobile ul a {
    display: block;
    font-size: 1.5rem;
    font-weight: 650;
    padding: var(--space-3) 0;
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
</style>
