---
import { Image } from 'astro:assets';
import { getPublicApps, priceLabel, platformNames, appHref } from '../lib/apps';
import { getCategory } from '../data/categories';
import { sections } from '../data/site';

const apps = (await getPublicApps()).slice(0, 8);
const hasLive = apps.some((a) => a.data.status === 'live');
---

{
  apps.length > 0 && (
    <section class="section" id="apps" aria-labelledby="apps-title">
      <div class="container">
        <div class="section-head">
          <h2 id="apps-title">{hasLive ? 'Featured apps' : 'Apps on the way'}</h2>
          <p>
            {hasLive
              ? 'Pick an app, see the price, install it in one step.'
              : 'Our first apps are in the works. Here is what they will do.'}
          </p>
        </div>

        <ul class="app-list" role="list">
          {apps.map((app) => {
            const d = app.data;
            const category = getCategory(d.category);
            return (
              <li class="app" id={`app-${d.slug}`}>
                <Image src={d.icon} alt="" width={64} height={64} class="app-icon" loading="lazy" />
                <div class="app-main">
                  <h3>
                    {sections.apps ? <a href={appHref(app)}>{d.name}</a> : d.name}
                    {d.example && <span class="tag tag-example">Example</span>}
                  </h3>
                  <p class="app-tagline">{d.tagline}</p>
                  <p class="app-meta">
                    <span>{d.type === 'mobile' ? 'Mobile' : 'Web app'}</span>
                    <span>{d.platforms.map((p) => platformNames[p]).join(', ')}</span>
                    {category && <span>{category.name}</span>}
                    <span>{priceLabel(app)}</span>
                  </p>
                </div>
                <div class="app-action">
                  {d.status === 'coming-soon' && <span class="tag tag-soon">Coming soon</span>}
                  {d.status === 'live' && d.type === 'mobile' && d.appStoreUrl && (
                    <a class="btn btn-primary btn-sm" href={d.appStoreUrl}>Get on App Store</a>
                  )}
                  {d.status === 'live' && d.type === 'mobile' && d.googlePlayUrl && (
                    <a class="btn btn-outline btn-sm" href={d.googlePlayUrl}>Get on Google Play</a>
                  )}
                  {d.status === 'live' && d.type === 'web' && d.webAppUrl && (
                    <a class="btn btn-primary btn-sm" href={d.webAppUrl}>Open app</a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .app-list {
    border-top: 1px solid var(--line);
  }

  .app {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .app :global(.app-icon) {
    width: 64px;
    height: 64px;
    border-radius: 16px;
  }

  .app-main {
    display: grid;
    gap: var(--space-1);
  }

  .app h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--fs-h3);
  }

  .app h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .app h3 a:hover {
    color: var(--accent);
  }

  .app-tagline {
    color: var(--text-muted);
  }

  .app-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .app-meta span + span::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: var(--space-4);
    vertical-align: middle;
    background: var(--accent);
    opacity: 0.7;
  }

  .app-action {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
    white-space: nowrap;
  }

  .tag-soon {
    color: var(--accent);
    background: rgb(189 218 38 / 0.1);
    border: 1px solid rgb(189 218 38 / 0.3);
  }

  .tag-example {
    color: var(--text-muted);
    border: 1px dashed var(--line-strong);
  }

  @media (max-width: 640px) {
    .app {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: var(--space-4);
    }
    .app :global(.app-icon) {
      width: 52px;
      height: 52px;
      border-radius: 13px;
    }
    .app-action {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
</style>
