---
// Страница «не найдено». Один шаблон на все языки: src/pages/404.astro и src/pages/[locale]/404.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicApps, appHref, appText } from '../lib/apps';
import { headerCta } from '../data/navigation';
import { defaultLocale, nonDefaultLocales, localizePath, useTranslations } from '../i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(locale);
const n = t.notFound;
const apps = await getPublicApps();
---

<BaseLayout title={t.meta.notFoundTitle} description={t.meta.notFoundDescription} noindex>
  {
    locale === defaultLocale && (
      <script is:inline slot="head" define:vars={{ locales: nonDefaultLocales }}>
        // GitHub Pages отдаёт этот файл для любого ненайденного адреса. Если адрес на другом
        // языке (/de/…), показываем страницу «не найдено» на этом языке. Это выбор по адресу,
        // а не по стране или языку браузера.
        (function () {
          var code = location.pathname.split('/')[1];
          if (locales.indexOf(code) !== -1 && location.pathname !== '/' + code + '/404/') {
            location.replace('/' + code + '/404/');
          }
        })();
      </script>
    )
  }
  <section class="container nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>{n.title}</h1>
    <p class="muted nf-lead">{n.lead}</p>

    <div class="nf-actions">
      <a class="btn btn-primary" href={localizePath('/', locale)}>{n.home}</a>
      <a class="btn btn-outline" href={localizePath(headerCta.href, locale)}>{n.explore}</a>
    </div>

    <form class="nf-search" role="search" action={localizePath('/', locale)} method="get" data-app-search>
      <label for="app-search" class="visually-hidden">{n.searchPlaceholder}</label>
      <input id="app-search" name="q" type="search" placeholder={n.searchPlaceholder} autocomplete="off" />
    </form>

    <ul class="nf-apps" role="list" data-app-list>
      {
        apps.map((a) => {
          const text = appText(a, locale);
          const category = t.categories.items[a.data.category].name;
          return (
            <li
              data-search={`${a.data.name} ${text.tagline} ${a.data.tagline} ${category} ${a.data.category} ${a.data.type}`.toLocaleLowerCase(locale)}
            >
              <a href={appHref(a, locale)}>{a.data.name}</a>
              <span class="muted"> — {text.tagline}</span>
            </li>
          );
        })
      }
    </ul>
    <p class="muted" data-no-results role="status" hidden>{n.noResults}</p>
  </section>
</BaseLayout>

<script>
  // Поиск по каталогу прямо на странице 404: фильтрует список приложений.
  const form = document.querySelector<HTMLFormElement>('[data-app-search]');
  const input = form?.querySelector('input');
  const items = document.querySelectorAll<HTMLElement>('[data-app-list] li');
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  const filter = () => {
    const q = (input?.value ?? '').trim().toLocaleLowerCase(document.documentElement.lang);
    let shown = 0;
    items.forEach((li) => {
      const match = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !match;
      if (match) shown++;
    });
    // «Ничего не найдено» — только когда человек что-то ввёл и совпадений нет.
    if (empty) empty.hidden = !q || shown > 0;
  };
  input?.addEventListener('input', filter);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
</script>

<style>
  .nf {
    display: grid;
    gap: var(--space-5);
    max-width: 44rem;
    padding-block: var(--space-8) 0;
  }

  .nf-code {
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
  }

  .nf h1 {
    font-size: var(--fs-h2);
  }

  .nf-lead {
    font-size: var(--fs-lead);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .nf-search {
    display: grid;
    margin-block-start: var(--space-4);
  }

  .nf-search input {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    min-height: 3rem;
  }

  .nf-search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nf-apps {
    display: grid;
    gap: var(--space-3);
  }

  .nf-apps a {
    font-weight: 600;
  }
</style>
