---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicApps, appHref } from '../lib/apps';
import { mainNav } from '../data/navigation';

const apps = await getPublicApps();
---

<BaseLayout
  title="Page not found — BitEon Studio"
  description="This page does not exist. Search the BitEon Studio app catalog or go to the main sections."
  noindex
>
  <section class="container nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>This page doesn’t exist</h1>
    <p class="muted nf-lead">The link may be old or mistyped. Find an app below or go to a main section.</p>

    <form class="nf-search" role="search" action="/" method="get" data-app-search>
      <label for="app-search">Search apps</label>
      <input id="app-search" name="q" type="search" placeholder="App name or what it does" autocomplete="off" />
    </form>

    <ul class="nf-apps" role="list" data-app-list>
      {
        apps.map((a) => (
          <li data-search={`${a.data.name} ${a.data.tagline} ${a.data.category} ${a.data.type}`.toLowerCase()}>
            <a href={appHref(a)}>{a.data.name}</a>
            <span class="muted"> — {a.data.tagline}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted" data-no-results hidden>No apps match that search.</p>

    <nav aria-label="Main sections" class="nf-links">
      <h2>Main sections</h2>
      <ul role="list">
        <li><a href="/">Home</a></li>
        {mainNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </section>
</BaseLayout>

<script>
  // Поиск по каталогу прямо на странице 404: фильтрует список приложений.
  const form = document.querySelector<HTMLFormElement>('[data-app-search]');
  const input = form?.querySelector('input');
  const items = document.querySelectorAll<HTMLElement>('[data-app-list] li');
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  const filter = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    items.forEach((li) => {
      const match = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  };
  input?.addEventListener('input', filter);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
</script>

<style>
  .nf {
    display: grid;
    gap: var(--space-5);
    max-width: 44rem;
    padding-block: var(--space-8) 0;
  }

  .nf-code {
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
  }

  .nf h1 {
    font-size: var(--fs-h2);
  }

  .nf-lead {
    font-size: var(--fs-lead);
  }

  .nf-search {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .nf-search label {
    font-weight: 600;
  }

  .nf-search input {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    min-height: 3rem;
  }

  .nf-search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nf-apps {
    display: grid;
    gap: var(--space-3);
  }

  .nf-apps a {
    font-weight: 600;
  }

  .nf-links {
    margin-top: var(--space-6);
  }

  .nf-links h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-3);
  }

  .nf-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }
</style>
