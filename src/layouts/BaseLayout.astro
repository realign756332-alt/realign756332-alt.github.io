---
import '../styles/global.css';
import BaseHead, { type SeoProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageHint from '../components/LanguageHint.astro';
import { getLocaleInfo, useTranslations } from '../i18n';

type Props = SeoProps;
const seo = Astro.props;
const locale = getLocaleInfo(Astro.currentLocale);
const t = useTranslations(locale.code);
---

<!doctype html>
<html lang={locale.code} dir={locale.dir}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <LanguageHint />
  </body>
</html>
